# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored. Nothing in it ever reaches GitHub.
#
# Note there is no NEXT_PUBLIC_ prefix on this one, and that is the whole
# point of lesson 5. A NEXT_PUBLIC_ variable gets baked into the JavaScript
# the browser downloads, so anyone can read it. This key is read only inside
# app/api/generate/route.ts, which runs on the server.

# Free key from https://aistudio.google.com -> Get API Key
GEMINI_API_KEY=your-gemini-api-key-here

# Clerk, for accounts. From https://dashboard.clerk.com -> API keys.
# The publishable key is the one exception to the rule above: it is designed to
# be public, it identifies your Clerk app to the browser, and it grants nothing
# on its own. The secret key is the one that must never carry that prefix.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your-publishable-key
CLERK_SECRET_KEY=sk_test_your-secret-key

# Neon Postgres. From https://console.neon.tech -> your project -> Connection
# string. Use the pooled one. It looks like:
#   postgresql://user:password@ep-something-pooler.region.aws.neon.tech/dbname?sslmode=require
#
# Paste it WITHOUT the surrounding quotes. Neon's copy button hands you the
# psql form, wrapped in single quotes, and this is a genuinely nasty one: the
# .env reader strips those quotes for you locally, so it works on your machine,
# while a hosting dashboard stores exactly what you pasted and the app gets a
# connection string that starts with an apostrophe. It fails only in production
# and the error says the URL is invalid, which it now is.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Vercel Blob, for photo files. Created automatically when you add a Blob store
# to the project in the Vercel dashboard (Storage -> Create -> Blob). Pull it
# down locally with `vercel env pull .env.local`.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your-token

# QStash, for background jobs. From https://console.upstash.com/qstash
# QStash can only call public URLs, so this path works on a deployed app or
# through a tunnel, never against plain localhost.
#
# QSTASH_URL is the region your token belongs to. The SDK defaults to the EU
# endpoint, so if you picked any other region you MUST set this or every
# publish is sent to a region your token is not valid in, and the error you
# get back says your token is wrong. Leave it blank for the EU region.
# The console prints the right value next to your keys.
QSTASH_URL=
QSTASH_TOKEN=your-qstash-token
QSTASH_CURRENT_SIGNING_KEY=sig_your-current-key
QSTASH_NEXT_SIGNING_KEY=sig_your-next-key

# DeepSeek, the paid rung of the AI ladder. Only used when the free tier
# refuses. From https://platform.deepseek.com. Leave it unset and the app
# simply has one fewer fallback.
DEEPSEEK_API_KEY=your-deepseek-key

# Stripe, in TEST MODE ONLY. From https://dashboard.stripe.com/test/apikeys
# lib/billing/stripe.ts refuses to start with anything that is not sk_test_,
# because a live key here would charge a real person during what everyone
# involved believes is a test.
STRIPE_SECRET_KEY=sk_test_your-test-key
# From the webhook endpoint you create in the Stripe dashboard, or from
# `stripe listen` when testing locally.
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Resend, for transactional email. From https://resend.com/api-keys
# EMAIL_FROM must be on a domain you have verified with Resend.
RESEND_API_KEY=re_your-resend-key
EMAIL_FROM="Trip Planner <hello@yourdomain.com>"

# Sentry, for knowing something broke before a user tells you.
# From https://sentry.io -> your project -> Client Keys (DSN).
# Leave unset and Sentry is entirely inert, which is what you want locally.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# PostHog, for product analytics. From https://posthog.com -> Project settings.
# The EU host keeps European users' data in the EU, which makes the privacy
# page easier to write and easier to keep true.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
